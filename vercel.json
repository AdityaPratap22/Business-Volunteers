{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.businessvolunteers.online"
        }
      ],
      "destination": "https://businessvolunteers.online/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "digitaldigix.in"
        }
      ],
      "destination": "https://businessvolunteers.online/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
