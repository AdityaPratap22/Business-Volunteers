    },
    {
      "source": "/portfolio-daily-mob-design.html",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/portfolio-layers-clothing.html",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/blog/:slug*",
      "destination": "/blogs/:slug*",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
