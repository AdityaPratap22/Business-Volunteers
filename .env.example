# ========================================================
# Business Volunteers - Environment Variables Configuration
# ========================================================

# 1. Resend API Key
# Sign up at https://resend.com and generate your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 2. Receiver Email Address
# The inbox where incoming lead submissions and notifications are delivered
RECEIVER_EMAIL=contact.businessvolunteers@gmail.com

# 3. Sender Email Address (Optional)
# If left blank, defaults to 'Business Volunteers Leads <onboarding@resend.dev>'
# Once your domain is verified on Resend (https://resend.com/domains), set your branded sender:
# RESEND_FROM_EMAIL=Business Volunteers <leads@businessvolunteers.online>
